[Unit]
Description=Network Pulse Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/network-pulse-agent
EnvironmentFile=/opt/network-pulse-agent/.env
ExecStart=/usr/bin/python3 /opt/network-pulse-agent/agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Modest hardening; loosen if the Pi's ping binary needs more.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
