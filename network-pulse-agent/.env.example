# Network Pulse Agent — per-device configuration
# Copy to .env and fill in values for THIS deployment. Every field below
# is a systemd EnvironmentFile-style KEY=VALUE line (no quotes, no export).

# --- Supabase ---------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# --- Identity -----------------------------------------------------------
# DEVICE_ID must match the uuid of the row in the `devices` table for this
# Pi. Business/client association is already encoded in devices.business_id
# on the Supabase side, so the agent itself only needs DEVICE_ID.
DEVICE_ID=00000000-0000-0000-0000-000000000000
# Optional human-readable label for log lines only (not sent to Supabase).
CLIENT_ID=example-client-site-name

# --- Timing ---------------------------------------------------------
CHECK_INTERVAL_SECONDS=30
FAILURE_THRESHOLD=3
PING_TIMEOUT_SECONDS=2

# --- Network targets ---------------------------------------------------
# Leave blank to auto-detect the default route's gateway every cycle.
GATEWAY_IP=
EXTERNAL_TARGETS=1.1.1.1,8.8.8.8

# --- Logging ---------------------------------------------------------
LOG_FILE=/var/log/network-pulse-agent/agent.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
